# Copy this file to .env and fill in real values. Never commit .env.

APP_NAME=tru-prompt-backend

# false in production, always -- while true, GET /api/users/auth/dev-login
# logs anyone in as a fixed test user with no password/SSO. Flip to true
# only in your own local .env, never in a deployed environment's config.
DEBUG=false

# Supabase project settings -> Project Settings -> API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection as the restricted, RLS-enforcing `tru_app` role.
# Use Supabase's pooler host (Project Settings -> Database -> Connection pooling),
# not the plain db.<ref>.supabase.co host -- that one is IPv6-only and often
# unreachable. See supabase_schema.sql / README "Isolation" section for how to
# create this role (it must have NOBYPASSRLS, unlike service_role/postgres).
# APP_DB_USER must be "tru_app.<project-ref>" -- the pooler (Supavisor) routes
# by that suffix and rejects a bare role name with "no tenant identifier provided".
APP_DB_HOST=
APP_DB_PORT=6543
APP_DB_NAME=postgres
APP_DB_USER=tru_app.<project-ref>
APP_DB_PASSWORD=

# Azure Portal -> App registrations -> your app
#   MS_CLIENT_ID: Application (client) ID
#   MS_CLIENT_SECRET: a client secret you generate under "Certificates & secrets"
#   MS_TENANT_ID: Directory (tenant) ID
#   MS_REDIRECT_URI: must exactly match a Redirect URI registered on the app
#     (Authentication -> Web -> Redirect URIs), e.g. http://localhost:8000/api/users/auth/microsoft
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT_ID=
MS_REDIRECT_URI=http://localhost:8000/api/users/auth/microsoft

# WorkOS (workos.com) -- lets a customer connect their own Okta/Azure AD/Google
# Workspace as an identity provider for their org. Scaffolded only (app/auth/workos.py),
# not wired into login yet -- see that file's module docstring for why.
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
WORKOS_REDIRECT_URI=http://localhost:8000/api/orgs/sso/callback

# Any long random string, e.g. `python -c "import secrets; print(secrets.token_hex(32))"`
JWT_SECRET=
JWT_EXPIRE_MINUTES=10080

# OpenAI API key used server-side only (never shipped to the browser)
OPENAI_API_KEY=

# OpenRouter (openrouter.ai) -- optional. If set to a real key, prompt generation
# routes through OpenRouter's free-tier model below instead of OpenAI, for
# testing without a paid OpenAI key. Get a free key at openrouter.ai/keys.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-oss-20b:free

# Resend (resend.com) -- sends invitation emails. Without a real key,
# send_invitation_email() just logs the invite link instead of sending.
RESEND_API_KEY=
EMAIL_FROM=TruPrompt <onboarding@resend.dev>

FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
# Optional comma-separated override; defaults to FRONTEND_URL
CORS_ORIGINS=
